FROM snowplow/snowplow-enrich-kinesis:6.10.0
USER root

# Fake geo + ISP databases — committed to the repo at config/maxmind/ and
# generated by tools/build_fake_geo_mmdb.py. No network dependency at build
# time; deterministic mapping from loader fake IP blocks to countries/cities/ISPs.
RUN mkdir -p /snowplow/config/maxmind
COPY maxmind/GeoLite2-City.mmdb /snowplow/config/maxmind/GeoLite2-City.mmdb
COPY maxmind/GeoIP2-ISP.mmdb    /snowplow/config/maxmind/GeoIP2-ISP.mmdb

COPY enrich.hocon /snowplow/config/enrich.hocon
COPY iglu-resolver.json /snowplow/config/iglu-resolver.json
COPY enrichments/ /snowplow/config/enrichments/
